    // Méthodes de filtrage
    filterUsers() {
        let users = [...this.data.users];
        
        if (this.filters.users.role) {
            users = users.filter(u => u.role === this.filters.users.role);
        }
        if (this.filters.users.status !== undefined) {
            users = users.filter(u => u.is_active === (this.filters.users.status === 'true'));
        }
        if (this.filters.users.search) {
            const search = this.filters.users.search.toLowerCase();
            users = users.filter(u => 
                u.username.toLowerCase().includes(search) ||
                u.email.toLowerCase().includes(search) ||
                (u.full_name && u.full_name.toLowerCase().includes(search))
            );
        }
        
        return users;
    }

    filterServers() {
        let servers = [...this.data.servers];
        
        if (this.filters.servers.type) {
            servers = servers.filter(s => s.server_type === this.filters.servers.type);
        }
        if (this.filters.servers.status) {
            servers = servers.filter(s => s.status === this.filters.servers.status);
        }
        if (this.filters.servers.active !== undefined) {
            servers = servers.filter(s => s.is_active === (this.filters.servers.active === 'true'));
        }
        if (this.filters.servers.search) {
            const search = this.filters.servers.search.toLowerCase();
            servers = servers.filter(s => 
                s.name.toLowerCase().includes(search) ||
                s.address.toLowerCase().includes(search)
            );
        }
        
        return servers;
    }

    filterAuditLogs() {
        let logs = [...this.data.auditLogs];
        
        if (this.filters.audit.action) {
            logs = logs.filter(l => l.action === this.filters.audit.action);
        }
        if (this.filters.audit.user) {
            logs = logs.filter(l => l.username === this.filters.audit.user);
        }
        if (this.filters.audit.startDate) {
            logs = logs.filter(l => new Date(l.timestamp) >= new Date(this.filters.audit.startDate));
        }
        if (this.filters.audit.endDate) {
            logs = logs.filter(l => new Date(l.timestamp) <= new Date(this.filters.audit.endDate));
        }
        
        return logs;
    }

    filterAlertsHistory() {
        let alerts = [...this.data.alertsHistory];
        
        if (this.filters.alerts.severity) {
            alerts = alerts.filter(a => a.severity === this.filters.alerts.severity);
        }
        if (this.filters.alerts.status) {
            alerts = alerts.filter(a => a.status === this.filters.alerts.status);
        }
        if (this.filters.alerts.server) {
            alerts = alerts.filter(a => a.server_name === this.filters.alerts.server);
        }
        if (this.filters.alerts.search) {
            const search = this.filters.alerts.search.toLowerCase();
            alerts = alerts.filter(a => 
                a.title.toLowerCase().includes(search) ||
                a.message.toLowerCase().includes(search)
            );
        }
        
        return alerts;
    }

