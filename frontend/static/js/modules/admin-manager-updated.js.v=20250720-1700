    generatePasswordInModal() {
        const passwordInput = document.getElementById('userPassword');
        const readableCheckbox = document.getElementById('readablePassword');
        
        // Générer un mot de passe côté client (simple)
        const length = 12;
        const charset = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789@#$%&*+=?";
        let password = "";
        
        for (let i = 0; i < length; i++) {
            password += charset.charAt(Math.floor(Math.random() * charset.length));
        }
        
        passwordInput.value = password;
        passwordInput.type = 'text'; // Afficher temporairement
        
        // Valider la force
        this.validatePasswordStrength();
        
        // Remettre en password après 3 secondes
        setTimeout(() => {
            if (passwordInput.type === 'text') {
                passwordInput.type = 'password';
                document.getElementById('togglePasswordBtn').innerHTML = '<i class="fas fa-eye"></i>';
            }
        }, 3000);
    }
    
    togglePasswordVisibility() {
        const passwordInput = document.getElementById('userPassword');
        const toggleBtn = document.getElementById('togglePasswordBtn');
        
        if (passwordInput.type === 'password') {
            passwordInput.type = 'text';
            toggleBtn.innerHTML = '<i class="fas fa-eye-slash"></i>';
        } else {
            passwordInput.type = 'password';
            toggleBtn.innerHTML = '<i class="fas fa-eye"></i>';
        }
    }
    
    validatePasswordStrength() {
        const passwordInput = document.getElementById('userPassword');
        const strengthContainer = document.getElementById('passwordStrength');
        const progressBar = strengthContainer.querySelector('.progress-bar');
        const feedback = document.getElementById('passwordFeedback');
        
        const password = passwordInput.value;
        
        if (!password) {
            strengthContainer.style.display = 'none';
            return;
        }
        
        strengthContainer.style.display = 'block';
        
        // Calcul simple de la force
        let score = 0;
        let feedbackText = [];
        
        if (password.length >= 8) score += 20;
        else feedbackText.push('Au moins 8 caractères');
        
        if (/[a-z]/.test(password)) score += 20;
        else feedbackText.push('Minuscules requises');
        
        if (/[A-Z]/.test(password)) score += 20;
        else feedbackText.push('Majuscules requises');
        
        if (/\d/.test(password)) score += 20;
        else feedbackText.push('Chiffres requis');
        
        if (/[!@#$%^&*(),.?":{}|<>]/.test(password)) score += 20;
        else feedbackText.push('Caractères spéciaux requis');
        
        // Affichage
        progressBar.style.width = score + '%';
        
        if (score >= 80) {
            progressBar.className = 'progress-bar bg-success';
            feedback.textContent = 'Mot de passe fort';
            feedback.className = 'text-success';
        } else if (score >= 60) {
            progressBar.className = 'progress-bar bg-warning';
            feedback.textContent = 'Mot de passe moyen';
            feedback.className = 'text-warning';
        } else {
            progressBar.className = 'progress-bar bg-danger';
            feedback.textContent = feedbackText.join(', ');
            feedback.className = 'text-danger';
        }
    }
    
    showGeneratedPassword(user, password, validation) {
        const modal = new bootstrap.Modal(document.getElementById('passwordDisplayModal'));
        
        document.getElementById('passwordDisplayUsername').textContent = `${user.username} (${user.email})`;
        document.getElementById('passwordDisplayValue').value = password;
        
        // Afficher la force du mot de passe
        const strengthContainer = document.getElementById('passwordStrengthDisplay');
        if (validation) {
            strengthContainer.innerHTML = `
                <div class="mb-2">
                    <small class="text-muted">Force: ${validation.strength}</small>
                    <div class="progress" style="height: 5px;">
                        <div class="progress-bar bg-${validation.strength_level === 'excellent' ? 'success' : validation.strength_level === 'good' ? 'info' : validation.strength_level === 'medium' ? 'warning' : 'danger'}" 
                             style="width: ${(validation.score / validation.max_score) * 100}%"></div>
                    </div>
                </div>
            `;
        }
        
        // Configurer les boutons
        document.getElementById('copyPasswordBtn').onclick = () => {
            navigator.clipboard.writeText(password).then(() => {
                this.showNotification('success', 'Mot de passe copié dans le presse-papier');
            });
        };
        
        document.getElementById('showPasswordBtn').onclick = () => {
            const input = document.getElementById('passwordDisplayValue');
            const btn = document.getElementById('showPasswordBtn');
            
            if (input.type === 'password') {
                input.type = 'text';
                btn.innerHTML = '<i class="fas fa-eye-slash"></i>';
            } else {
                input.type = 'password';
                btn.innerHTML = '<i class="fas fa-eye"></i>';
            }
        };
        
        modal.show();
    }
    
