        const passwordInput = document.getElementById('userPassword');
        passwordInput.oninput = () => this.validatePasswordStrength();
        
        // Génération automatique du username
        const firstNameInput = document.getElementById('userFirstName');
        const lastNameInput = document.getElementById('userLastName');
        const usernameInput = document.getElementById('userUsername');
        
        const generateUsername = () => {
            if (!usernameInput.value && firstNameInput.value && lastNameInput.value) {
                const firstName = firstNameInput.value.toLowerCase().replace(/[^a-z]/g, '');
                const lastName = lastNameInput.value.toLowerCase().replace(/[^a-z]/g, '');
                usernameInput.placeholder = `${firstName}.${lastName}`;
            }
        };
        
        firstNameInput.oninput = generateUsername;
        lastNameInput.oninput = generateUsername;
    }
    
    async saveUser() {
        const form = document.getElementById('userForm');
        const formData = new FormData(form);
        const userId = formData.get('userId');
        
        // Construire l'objet de données
        const userData = {
            first_name: formData.get('first_name'),
            last_name: formData.get('last_name'),
            username: formData.get('username'),
            email: formData.get('email'),
            role: formData.get('role'),
            is_active: formData.has('is_active'),
            password: formData.get('password'),
            readable_password: formData.has('readable_password')
        };
        
        // Validation basique
        if (!userData.email || !userData.role) {
            alert('Email et rôle sont requis');
            return;
        }
        
        try {
            let url, method;
            if (userId) {
                // Modification
                url = `/api/admin/users/${userId}`;
                method = 'PUT';
                // Ne pas envoyer le mot de passe en modification (sauf si spécifié)
                if (!userData.password) {
                    delete userData.password;
                    delete userData.readable_password;
                }
            } else {
                // Création
                url = '/api/admin/users';
                method = 'POST';
            }
            
            const response = await fetch(url, {
                method: method,
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify(userData)
            });
            
            const result = await response.json();
            
            if (response.ok) {
                console.log('✅ Utilisateur sauvegardé:', result);
                
                // Fermer le modal
                bootstrap.Modal.getInstance(document.getElementById('userModal')).hide();
                
                // Afficher le mot de passe généré si applicable
                if (result.auto_generated_password && result.generated_password) {
                    this.showGeneratedPassword(result.user, result.generated_password, result.password_validation);
                }
                
                // Recharger la liste des utilisateurs
                this.renderUsers();
                
                // Message de succès
                this.showNotification('success', result.message);
                
            } else {
                throw new Error(result.error || 'Erreur lors de la sauvegarde');
            }
            
        } catch (error) {
            console.error('❌ Erreur sauvegarde utilisateur:', error);
            alert('Erreur lors de la sauvegarde: ' + error.message);
        }
    }

    // Fonctions de gestion des utilisateurs
    async toggleUserStatus(userId) {
        // Trouver l'utilisateur
        const user = this.data.users?.find(u => u.id === userId);
        if (!user) {
            alert('Utilisateur non trouvé');
