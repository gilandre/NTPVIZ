# Configuration NTPVIZ - Variables d'environnement
# Copiez ce fichier vers .env et modifiez les valeurs selon vos besoins

# Configuration de l'application
SECRET_KEY=ntp-monitor-2025-secret-key-change-me
DEBUG=False
TESTING=False

# Configuration du serveur
HOST=0.0.0.0
PORT=5001

# Configuration de la base de données
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=ntp_user
MYSQL_PASSWORD=NTP_Monitor_2025!
MYSQL_DATABASE=ntp_monitor

# Configuration des logs
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# Configuration du monitoring
MONITORING_INTERVAL=30
CLIENT_MONITORING_ENABLED=true

# Configuration des alertes
ALERT_CHECK_INTERVAL=60
ALERT_RETENTION_DAYS=30

# Configuration de sécurité
SESSION_COOKIE_SECURE=False  # Mettre True en production avec HTTPS
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax
PERMANENT_SESSION_LIFETIME=3600 