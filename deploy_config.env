# Configuration Déploiement GitHub vers Serveur Ubuntu 24.04
# NTP Monitor Enterprise - Variables d'environnement

# ==========================================
# CONFIGURATION GITHUB
# ==========================================

# URL du repository GitHub (À MODIFIER selon votre repo)
GITHUB_REPO_URL="https://github.com/votre-username/ntp-monitor.git"

# Branche à déployer
GITHUB_BRANCH="main"

# Authentification GitHub (si repo privé)
# GITHUB_TOKEN="your_github_personal_access_token"
# GITHUB_USERNAME="your_username"

# ==========================================
# CONFIGURATION SERVEUR
# ==========================================

# Répertoires
APP_NAME="ntp-monitor"
APP_DIR="/opt/ntp-monitor"
BACKUP_DIR="/opt/ntp-monitor-backup"
LOG_DIR="/var/log"

# Utilisateur dédié
USER_APP="ntp-monitor"
GROUP_APP="ntp-monitor"

# Services
SERVICE_NAME="ntp-monitor"
WORKER_SERVICE="${SERVICE_NAME}-worker"

# ==========================================
# CONFIGURATION BASE DE DONNÉES
# ==========================================

# MySQL/MariaDB (production recommandée)
MYSQL_HOST="localhost"
MYSQL_PORT="3306"
MYSQL_USER="root"
MYSQL_PASSWORD=""
MYSQL_DATABASE="ntp_monitor"

# SQLite (fallback automatique)
SQLITE_PATH="instance/ntp_monitor.db"

# ==========================================
# CONFIGURATION SÉCURITÉ
# ==========================================

# Clé secrète Flask (GÉNÉRER UNE NOUVELLE CLÉ!)
SECRET_KEY="ntp-monitor-production-$(openssl rand -hex 32)"

# Configuration SSL/TLS (pour HTTPS)
SSL_ENABLED="false"
SSL_CERT_PATH="/etc/ssl/certs/ntp-monitor.crt"
SSL_KEY_PATH="/etc/ssl/private/ntp-monitor.key"

# ==========================================
# CONFIGURATION RÉSEAU
# ==========================================

# Port application Flask
FLASK_PORT="5000"
FLASK_HOST="127.0.0.1"

# Configuration Nginx
NGINX_SERVER_NAME="localhost"
NGINX_PORT="80"
NGINX_SSL_PORT="443"

# Serveurs NTP à surveiller (séparés par des virgules)
NTP_SERVERS="pool.ntp.org,time.google.com,time.cloudflare.com,fr.pool.ntp.org,europe.pool.ntp.org,0.fr.pool.ntp.org,1.fr.pool.ntp.org,2.fr.pool.ntp.org"

# ==========================================
# CONFIGURATION MONITORING
# ==========================================

# Intervalle monitoring NTP (secondes)
NTP_CHECK_INTERVAL="60"

# Seuils d'alerte
NTP_OFFSET_WARNING="100"    # millisecondes
NTP_OFFSET_CRITICAL="500"   # millisecondes
NTP_DELAY_WARNING="200"     # millisecondes
NTP_DELAY_CRITICAL="1000"   # millisecondes

# ==========================================
# CONFIGURATION LOGGING
# ==========================================

# Niveau de log (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL="INFO"

# Rotation des logs
LOG_MAX_SIZE="100MB"
LOG_BACKUP_COUNT="10"

# ==========================================
# CONFIGURATION PERFORMANCE
# ==========================================

# Workers Gunicorn (recommandé: 2 * CPU cores + 1)
GUNICORN_WORKERS="5"
GUNICORN_THREADS="2"
GUNICORN_MAX_REQUESTS="1000"
GUNICORN_TIMEOUT="60"

# Workers Celery
CELERY_WORKERS="2"
CELERY_CONCURRENCY="4"

# ==========================================
# CONFIGURATION BACKUP
# ==========================================

# Nombre de sauvegardes à conserver
BACKUP_RETENTION="5"

# Sauvegarde automatique base de données
DB_BACKUP_ENABLED="true"
DB_BACKUP_INTERVAL="daily"
DB_BACKUP_PATH="/opt/ntp-monitor-backups/db"

# ==========================================
# CONFIGURATION NOTIFICATIONS
# ==========================================

# Email (pour les alertes)
SMTP_ENABLED="false"
SMTP_SERVER="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USERNAME="your_email@gmail.com"
SMTP_PASSWORD="your_app_password"
SMTP_FROM="NTP Monitor <ntp-monitor@yourdomain.com>"
SMTP_TO="admin@yourdomain.com"

# Webhook (Slack, Discord, etc.)
WEBHOOK_ENABLED="false"
WEBHOOK_URL="https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK"

# ==========================================
# CONFIGURATION DÉVELOPPEMENT/PRODUCTION
# ==========================================

# Environnement (development, production)
FLASK_ENV="production"

# Debug mode (JAMAIS true en production!)
DEBUG="false"

# Testing mode
TESTING="false"

# ==========================================
# VERSIONS PACKAGES (corrections appliquées)
# ==========================================

# Versions corrigées pour éviter erreur 'partitioned'
FLASK_VERSION="2.3.3"
WERKZEUG_VERSION="2.3.7"
REDIS_VERSION="4.6.0"
CELERY_VERSION="5.3.4"
SOCKETIO_VERSION="5.8.0"
FLASK_SOCKETIO_VERSION="5.3.6"

# ==========================================
# CONFIGURATION SYSTÈME
# ==========================================

# Timezone
TIMEZONE="Europe/Paris"

# Locale
LOCALE="fr_FR.UTF-8"

# ==========================================
# INSTRUCTIONS D'UTILISATION
# ==========================================

# 1. Modifiez les variables selon votre environnement
# 2. Particulièrement important: GITHUB_REPO_URL, SECRET_KEY, MYSQL_*
# 3. Pour charger ces variables: source deploy_config.env
# 4. Puis exécuter: sudo -E bash deploy_github_to_server.sh

# SÉCURITÉ IMPORTANTE:
# - Changez SECRET_KEY en production
# - Configurez des mots de passe MySQL forts
# - Activez HTTPS avec des certificats valides
# - Restreignez l'accès réseau si nécessaire 