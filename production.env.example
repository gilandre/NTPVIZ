# NTP Monitor Enterprise - Configuration Production
# Copiez ce fichier vers .env et modifiez les valeurs selon votre environnement

# ===========================================
# APPLICATION CONFIGURATION
# ===========================================
FLASK_ENV=production
SECRET_KEY=your-super-secret-key-change-this-in-production
HOST=0.0.0.0
PORT=5000

# ===========================================
# DATABASE CONFIGURATION
# ===========================================
# SQLite (pour petites installations)
DATABASE_URL=sqlite:///ntp_monitor_prod.db

# PostgreSQL (recommandé pour production)
# DATABASE_URL=postgresql://username:password@localhost/ntp_monitor_prod

# MySQL (alternative)
# DATABASE_URL=mysql://username:password@localhost/ntp_monitor_prod

# ===========================================
# REDIS CONFIGURATION
# ===========================================
REDIS_URL=redis://localhost:6379/0

# ===========================================
# LOGGING CONFIGURATION
# ===========================================
LOG_TO_STDOUT=true
LOG_LEVEL=INFO

# ===========================================
# EMAIL CONFIGURATION (pour les alertes)
# ===========================================
# Configuration SMTP pour l'envoi d'emails
ALERTS_EMAIL_SMTP_HOST=smtp.gmail.com
ALERTS_EMAIL_SMTP_PORT=587
ALERTS_EMAIL_SMTP_USER=your-email@gmail.com
ALERTS_EMAIL_SMTP_PASSWORD=your-email-password
ALERTS_EMAIL_USE_TLS=true
ALERTS_EMAIL_FROM=ntp-monitor@yourcompany.com

# ===========================================
# WEBHOOK CONFIGURATION (pour les alertes)
# ===========================================
# URL du webhook pour les notifications
ALERTS_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK
ALERTS_WEBHOOK_SECRET=your-webhook-secret-key
ALERTS_WEBHOOK_TIMEOUT=10

# ===========================================
# NTP CONFIGURATION
# ===========================================
# Intervalle de vérification NTP (en secondes)
NTP_QUERY_INTERVAL=60
NTP_DEFAULT_TIMEOUT=10
NTP_MAX_OFFSET_WARNING=1.0
NTP_MAX_OFFSET_CRITICAL=5.0

# ===========================================
# MONITORING CONFIGURATION
# ===========================================
# Rétention des logs (en jours)
LOG_RETENTION_DAYS=30
# Rétention des alertes résolues (en jours)
ALERT_RETENTION_DAYS=7

# ===========================================
# SECURITY CONFIGURATION
# ===========================================
# Activation du HTTPS (si utilisé derrière un proxy)
FORCE_HTTPS=false
# Durée de session (en heures)
SESSION_LIFETIME_HOURS=24

# ===========================================
# BACKUP CONFIGURATION
# ===========================================
# Répertoire pour les backups automatiques
BACKUP_DIRECTORY=/var/backups/ntp-monitor
# Fréquence des backups automatiques (en heures)
BACKUP_INTERVAL_HOURS=24
# Nombre de backups à conserver
BACKUP_RETENTION_COUNT=7

# ===========================================
# PERFORMANCE CONFIGURATION
# ===========================================
# Nombre de workers Gunicorn
GUNICORN_WORKERS=4
# Timeout des requêtes
GUNICORN_TIMEOUT=30
# Limite mémoire par worker
GUNICORN_MAX_REQUESTS=1000 