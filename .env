# ============================================================================
# NTP Monitor Enterprise - Configuration Production
# ============================================================================

# APPLICATION
FLASK_ENV=production
SECRET_KEY=changez-cette-cle-secrete-en-production
DEBUG=false
HOST=0.0.0.0
PORT=5001

# BASE DE DONNEES (MySQL Recommandé en production)
DATABASE_URL=mysql+pymysql://ntp_user:password@localhost/ntp_monitor
# Alternative SQLite: DATABASE_URL=sqlite:///instance/ntp_monitor.db

# NTP CONFIGURATION
DEFAULT_NTP_SERVERS=pool.ntp.org,time.google.com,time.cloudflare.com
LOCAL_NTP_SERVERS=192.168.1.100,10.0.0.50

# ALERTES
ALERT_OFFSET_THRESHOLD=100
ALERT_DELAY_THRESHOLD=500

# REDIS
REDIS_URL=redis://localhost:6379/0

# LOGGING
LOG_LEVEL=INFO
LOG_TO_STDOUT=true

# SECURITE
WTF_CSRF_ENABLED=true
SESSION_PERMANENT=false
PERMANENT_SESSION_LIFETIME=3600
